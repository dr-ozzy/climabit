<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/temperatura" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="34sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" android:text="--°" />
        <TextView android:id="@+id/ceu" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
        <TextView android:id="@+id/max_min" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
    </LinearLayout>
    <LinearLayout android:id="@+id/alerta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp"
        android:paddingBottom="3dp" android:visibility="gone">
        <TextView android:id="@+id/alerta_texto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
