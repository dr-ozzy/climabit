<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="10dp">
        <TextView android:id="@+id/cidade" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
        <TextView android:id="@+id/temperatura" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="42sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" android:text="--°" />
        <TextView android:id="@+id/ceu" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="15sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/max_min" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold" android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
            <TextView android:id="@+id/chuva" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/hora" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|end"
        android:padding="10dp" android:textColor="#FFFFFF" android:textSize="11sp"
        android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" />
    <LinearLayout android:id="@+id/alerta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp"
        android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/alerta_texto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
