<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Cartão claro": relógio, cidade, temperatura e gráfico das próximas horas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fundo_claro"
    android:clipToOutline="true"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="H:mm" android:format12Hour="h:mm"
                android:textColor="#1B1D21" android:textSize="40sp"
                android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="2dp">
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="EEE, d MMM" android:format12Hour="EEE, d MMM"
                    android:textColor="#3A3D44" android:textSize="12sp" android:textAllCaps="true" />
                <TextView android:id="@+id/cidade" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#3A3D44"
                    android:textSize="12sp" android:textAllCaps="true" android:maxLines="1"
                    android:ellipsize="end" android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/sensacao" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#3A3D44" android:textSize="12sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/icone" android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_tempo_parcial_dia" android:importantForAccessibility="no" />
                <TextView android:id="@+id/temperatura" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:text="--°" android:textColor="#1B1D21" android:textSize="30sp"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:id="@+id/max_min" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#3A3D44" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/detalhes" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#3A3D44" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/grafico" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/alerta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2dp"
        android:paddingBottom="3dp" android:visibility="gone">
        <TextView android:id="@+id/alerta_texto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
