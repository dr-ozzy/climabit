<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/temperatura" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
        android:shadowColor="#E60B1220" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="3" android:text="--°" />
    <TextView android:id="@+id/alerta" android:layout_width="match_parent"
        android:layout_height="6dp" android:layout_gravity="top"
        android:visibility="gone" />
</FrameLayout>
