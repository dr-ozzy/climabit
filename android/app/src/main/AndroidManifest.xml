<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Só a localização aproximada; usada para escolher o município, nunca enviada. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mantém a verificação de alertas depois de reiniciar o celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Instalar a versão nova baixada do GitHub (o Android pede confirmação ao usuário). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="ClimaBit"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/sem_backup"
        android:networkSecurityConfig="@xml/rede"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Widgets da tela inicial do celular. -->
        <receiver android:name=".WidgetClima1x1" android:exported="false"
            android:label="ClimaBit pequeno (1×1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_clima_1x1" />
        </receiver>
        <receiver android:name=".WidgetClima2x2" android:exported="false"
            android:label="ClimaBit médio (2×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_clima_2x2" />
        </receiver>
        <receiver android:name=".WidgetClima4x2" android:exported="false"
            android:label="ClimaBit grande (4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_clima_4x2" />
        </receiver>
        <receiver android:name=".WidgetSimples1x1" android:exported="false"
            android:label="ClimaBit simples pequeno (1×1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_simples_1x1" />
        </receiver>
        <receiver android:name=".WidgetSimples2x2" android:exported="false"
            android:label="ClimaBit simples médio (2×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_simples_2x2" />
        </receiver>
        <receiver android:name=".WidgetSimples4x2" android:exported="false"
            android:label="ClimaBit simples grande (4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_simples_4x2" />
        </receiver>
        <receiver android:name=".WidgetCartao" android:exported="false"
            android:label="ClimaBit cartão claro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_cartao" />
        </receiver>
        <receiver android:name=".WidgetHorario" android:exported="false"
            android:label="ClimaBit horário escuro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_horario" />
        </receiver>
        <receiver android:name=".WidgetClima4x1" android:exported="false"
            android:label="ClimaBit barra (4×1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_clima_4x1" />
        </receiver>
        <receiver android:name=".WidgetSimples4x1" android:exported="false"
            android:label="ClimaBit simples barra (4×1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_simples_4x1" />
        </receiver>
        <!-- Entrega o APK da atualização ao instalador do Android. -->
        <provider
            android:name=".ArquivosAtualizacao"
            android:authorities="${applicationId}.atualizacao"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/atualizacao_arquivos" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
